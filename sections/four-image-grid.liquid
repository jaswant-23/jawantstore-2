<!-- ========================================
  FOUR IMAGE GRID SECTION
======================================== -->
<section id="fourImageGrid" class="four-image-grid">
  <div class="four-image-grid__container">

    <!-- Item 1 -->
    <div class="four-image-grid__item">
      {%- if section.settings.image_1 != blank -%}
        <img
          src="{{ section.settings.image_1 | image_url: width: 800 }}"
          alt="Image 1"
          width="800"
          height="800"
          loading="lazy"
        >
      {%- endif -%}
    </div>

    <!-- Item 2 -->
    <div class="four-image-grid__item">
      {%- if section.settings.image_2 != blank -%}
        <img
          src="{{ section.settings.image_2 | image_url: width: 800 }}"
          alt="Image 2"
          width="800"
          height="800"
          loading="lazy"
        >
      {%- endif -%}
    </div>

    <!-- Item 3 -->
    <div class="four-image-grid__item">
      {%- if section.settings.image_3 != blank -%}
        <img
          src="{{ section.settings.image_3 | image_url: width: 800 }}"
          alt="Image 3"
          width="800"
          height="800"
          loading="lazy"
        >
      {%- endif -%}
    </div>

    <!-- Item 4 -->
    <div class="four-image-grid__item">
      {%- if section.settings.image_4 != blank -%}
        <img
          src="{{ section.settings.image_4 | image_url: width: 800 }}"
          alt="Image 4"
          width="800"
          height="800"
          loading="lazy"
        >
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Four Image Grid",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    }
  ],
  "presets": [
    {
      "name": "Four Image Grid"
    }
  ]
}
{% endschema %}