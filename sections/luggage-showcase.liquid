{% comment %} 
  ============================================================
  RARE LUGGAGE SHOWCASE — Full Section (Liquid + CSS + JS)
  File: sections/rare-luggage-showcase.liquid
  ============================================================ 
{% endcomment %}

<!-- ========================================
  LUGGAGE SHOWCASE SECTION
  ======================================== -->
<section id="rareLuggageShowcase-{{ section.id }}" class="rare-luggage-showcase">
  <div class="rare-luggage-showcase__wrapper">

    {%- for block in section.blocks -%}
      {%- assign card_index = forloop.index0 -%}

      <div
        class="luggage-card"
        {{ block.shopify_attributes }}
        data-card-index="{{ card_index }}">

        <!-- ── Left: Main Image + Arrows ── -->
        <div class="luggage-card__media">

          <button
            class="luggage-card__arrow luggage-card__arrow--prev"
            data-card="{{ card_index }}"
            data-dir="-1"
            aria-label="Previous image">&#8249;</button>

          {%- if block.settings.product_image != blank -%}
            <img
              id="luggage-main-img-{{ card_index }}"
              class="luggage-card__main-img"
              src="{{ block.settings.product_image | image_url: width: 1200 }}"
              alt="{{ block.settings.product_title | escape }}"
              loading="lazy"
              width="1200"
              height="1200"
              data-thumb-index="0">
          {%- else -%}
            <img
              id="luggage-main-img-{{ card_index }}"
              class="luggage-card__main-img"
              src="{{ 'product-1' | placeholder_svg_tag }}"
              alt="{{ block.settings.product_title | escape }}"
              loading="lazy"
              width="1200"
              height="1200"
              data-thumb-index="0">
          {%- endif -%}

          <button
            class="luggage-card__arrow luggage-card__arrow--next"
            data-card="{{ card_index }}"
            data-dir="1"
            aria-label="Next image">&#8250;</button>

        </div>

        <!-- ── Right: Content ── -->
        <div class="luggage-card__content">

          <!-- Color row (top right) -->
          <div class="luggage-card__color-row">
            {%- if block.settings.finish_text != blank -%}
              <span class="luggage-color-label">Color:</span>
              <span class="luggage-color-value">{{ block.settings.finish_text }}</span>
            {%- endif -%}
          </div>

          <!-- Title + Description -->
          <div class="luggage-card__header">
            {%- if block.settings.product_title != blank -%}
              <h2>{{ block.settings.product_title }}</h2>
            {%- endif -%}
            {%- if block.settings.product_description != blank -%}
              <p>{{ block.settings.product_description }}</p>
            {%- endif -%}
          </div>

          <!-- Thumbnails -->
          <div class="luggage-card__thumbnails" id="luggage-thumbs-{{ card_index }}">

            {%- if block.settings.product_image != blank -%}
              <div
                class="luggage-thumb active"
                data-card="{{ card_index }}"
                data-thumb-index="0"
                data-full="{{ block.settings.product_image | image_url: width: 1200 }}"
                data-alt="{{ block.settings.product_title | escape }}"
                role="button"
                tabindex="0"
                aria-label="View main image">
                <img
                  src="{{ block.settings.product_image | image_url: width: 300 }}"
                  alt="{{ block.settings.product_title | escape }} thumbnail"
                  loading="lazy"
                  width="300"
                  height="300">
              </div>
            {%- endif -%}

            {%- if block.settings.thumb_2 != blank -%}
              <div
                class="luggage-thumb"
                data-card="{{ card_index }}"
                data-thumb-index="1"
                data-full="{{ block.settings.thumb_2 | image_url: width: 1200 }}"
                data-alt="{{ block.settings.product_title | escape }} view 2"
                role="button"
                tabindex="0"
                aria-label="View image 2">
                <img
                  src="{{ block.settings.thumb_2 | image_url: width: 300 }}"
                  alt="{{ block.settings.product_title | escape }} thumbnail 2"
                  loading="lazy"
                  width="300"
                  height="300">
              </div>
            {%- endif -%}

            {%- if block.settings.thumb_3 != blank -%}
              <div
                class="luggage-thumb"
                data-card="{{ card_index }}"
                data-thumb-index="2"
                data-full="{{ block.settings.thumb_3 | image_url: width: 1200 }}"
                data-alt="{{ block.settings.product_title | escape }} view 3"
                role="button"
                tabindex="0"
                aria-label="View image 3">
                <img
                  src="{{ block.settings.thumb_3 | image_url: width: 300 }}"
                  alt="{{ block.settings.product_title | escape }} thumbnail 3"
                  loading="lazy"
                  width="300"
                  height="300">
              </div>
            {%- endif -%}

            {%- if block.settings.thumb_4 != blank -%}
              <div
                class="luggage-thumb"
                data-card="{{ card_index }}"
                data-thumb-index="3"
                data-full="{{ block.settings.thumb_4 | image_url: width: 1200 }}"
                data-alt="{{ block.settings.product_title | escape }} view 4"
                role="button"
                tabindex="0"
                aria-label="View image 4">
                <img
                  src="{{ block.settings.thumb_4 | image_url: width: 300 }}"
                  alt="{{ block.settings.product_title | escape }} thumbnail 4"
                  loading="lazy"
                  width="300"
                  height="300">
              </div>
            {%- endif -%}

          </div>

          <!-- Size Options -->
          <div class="luggage-card__option-group">
            <div class="luggage-size-header">
              <span class="option-label">Size:</span>
              {%- if block.settings.size_chart_link != blank -%}
                <a
                  href="{{ block.settings.size_chart_link }}"
                  class="size-chart-link"
                  target="_blank">Size chart</a>
              {%- else -%}
                <span class="size-chart-link" style="visibility:hidden;">Size chart</span>
              {%- endif -%}
            </div>
            <div class="luggage-size-options">

              {%- if block.settings.size_1 != blank -%}
                <button
                  class="luggage-size-pill{% if block.settings.active_size == 'size_1' %} active{% endif %}"
                  data-card="{{ card_index }}"
                  type="button">
                  {{ block.settings.size_1 }}
                </button>
              {%- endif -%}

              {%- if block.settings.size_2 != blank -%}
                <button
                  class="luggage-size-pill{% if block.settings.active_size == 'size_2' %} active{% endif %}"
                  data-card="{{ card_index }}"
                  type="button">
                  {{ block.settings.size_2 }}
                </button>
              {%- endif -%}

              {%- if block.settings.size_3 != blank -%}
                <button
                  class="luggage-size-pill{% if block.settings.active_size == 'size_3' %} active{% endif %}"
                  data-card="{{ card_index }}"
                  type="button">
                  {{ block.settings.size_3 }}
                </button>
              {%- endif -%}

              {%- if block.settings.size_4 != blank -%}
                <button
                  class="luggage-size-pill{% if block.settings.active_size == 'size_4' %} active{% endif %}"
                  data-card="{{ card_index }}"
                  type="button">
                  {{ block.settings.size_4 }}
                </button>
              {%- endif -%}

              {%- if block.settings.size_5 != blank -%}
                <button
                  class="luggage-size-pill{% if block.settings.active_size == 'size_5' %} active{% endif %}"
                  data-card="{{ card_index }}"
                  type="button">
                  {{ block.settings.size_5 }}
                </button>
              {%- endif -%}

            </div>
          </div>

          <!-- Price -->
          <div class="luggage-card__price">
            <div class="luggage-price-row">
              {%- if block.settings.price_text != blank -%}
                <span class="luggage-price-main">{{ block.settings.price_text }}</span>
              {%- endif -%}
              {%- if block.settings.price_old != blank -%}
                <span class="luggage-price-old">{{ block.settings.price_old }}</span>
              {%- endif -%}
            </div>
            {%- if block.settings.price_note != blank -%}
              <p class="luggage-price-note">{{ block.settings.price_note }}</p>
            {%- endif -%}
          </div>

          <!-- Buttons -->
          <div class="luggage-card__actions">
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link | default: '#' }}" class="luggage-btn luggage-btn--primary">{{ block.settings.button_label }}</a>
            {%- endif -%}

            {%- if block.settings.button_2_label != blank -%}
              <a href="{{ block.settings.button_2_link | default: '#' }}" class="luggage-btn luggage-btn--secondary">{{ block.settings.button_2_label }}</a>
            {%- endif -%}
          </div>

        </div>
      <!-- /.luggage-card__content -->
      </div>
      <!-- /.luggage-card -->

    {%- endfor -%}

  </div>
<!-- /.rare-luggage-showcase__wrapper -->
</section>



<!-- ========================================
  JAVASCRIPT
  ======================================== -->
<script>
  (function () {
  'use strict';
  
  /* ── Per-card state ── */
  var lcState = {};
  
  /* ── Init all cards in this section ── */
  function initLuggageShowcase() {
    var section = document.getElementById('rareLuggageShowcase-{{ section.id }}');
    if (!section) return;
  
    var cards = section.querySelectorAll('.luggage-card');
  
    cards.forEach(function (card) {
      var idx = card.getAttribute('data-card-index');
      if (idx === null) return;
  
      /* Collect all thumb elements for this card */
      var thumbEls = card.querySelectorAll('.luggage-thumb[data-card="' + idx + '"]');
  
      /* Build thumb data array from DOM */
      var thumbData = [];
      thumbEls.forEach(function (el) {
        thumbData.push({
          full: el.getAttribute('data-full') || '',
          alt: el.getAttribute('data-alt') || ''
        });
      });
  
      /* Init state */
      lcState[idx] = {
        activeThumb: 0,
        totalThumbs: thumbData.length,
        thumbData: thumbData
      };
    });
  
    /* Delegate events on section */
    section.addEventListener('click', handleClick);
    section.addEventListener('keydown', handleKeydown);
  }
  
  /* ── Unified click handler ── */
  function handleClick(e) {
    /* Thumbnail */
    var thumb = e.target.closest('.luggage-thumb');
    if (thumb) {
      var ci = thumb.getAttribute('data-card');
      var ti = parseInt(thumb.getAttribute('data-thumb-index'), 10);
      switchImage(ci, ti);
      return;
    }
  
    /* Arrow */
    var arrow = e.target.closest('.luggage-card__arrow');
    if (arrow) {
      var ci = arrow.getAttribute('data-card');
      var dir = parseInt(arrow.getAttribute('data-dir'), 10);
      var s = lcState[ci];
      if (!s) return;
      var next = (s.activeThumb + dir + s.totalThumbs) % s.totalThumbs;
      switchImage(ci, next);
      return;
    }
  
    /* Size pill */
    var pill = e.target.closest('.luggage-size-pill');
    if (pill) {
      var ci = pill.getAttribute('data-card');
      var card = document.querySelector('.luggage-card[data-card-index="' + ci + '"]');
      if (!card) return;
      card.querySelectorAll('.luggage-size-pill').forEach(function (p) {
        p.classList.remove('active');
      });
      pill.classList.add('active');
    }
  }
  
  /* ── Keyboard handler ── */
  function handleKeydown(e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    var thumb = e.target.closest('.luggage-thumb');
    if (thumb) {
      e.preventDefault();
      var ci = thumb.getAttribute('data-card');
      var ti = parseInt(thumb.getAttribute('data-thumb-index'), 10);
      switchImage(ci, ti);
    }
  }
  
  /* ── Switch main image with fade ── */
  function switchImage(cardIndex, thumbIndex) {
    var s = lcState[cardIndex];
    if (!s || thumbIndex === s.activeThumb) return;
  
    var thumbData = s.thumbData[thumbIndex];
    if (!thumbData || !thumbData.full) return;
  
    var mainImg = document.getElementById('luggage-main-img-' + cardIndex);
    if (!mainImg) return;
  
    /* Fade out */
    mainImg.classList.add('lc-fading');
  
    setTimeout(function () {
      mainImg.src = thumbData.full;
      mainImg.alt = thumbData.alt;
      s.activeThumb = thumbIndex;
  
      /* Update active thumb border */
      var card = document.querySelector('.luggage-card[data-card-index="' + cardIndex + '"]');
      if (card) {
        card.querySelectorAll('.luggage-thumb').forEach(function (el, i) {
          el.classList.toggle('active', i === thumbIndex);
        });
      }
  
      /* Fade in after image loads */
      mainImg.onload = function () {
        mainImg.classList.remove('lc-fading');
        mainImg.onload = null;
      };
      /* Fallback for cached images */
      setTimeout(function () {
        mainImg.classList.remove('lc-fading');
      }, 350);
  
    }, 220);
  }
  
  /* ── Run on DOM ready ── */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLuggageShowcase);
  } else {
    initLuggageShowcase();
  }
  
  /* ── Shopify theme editor: re-init on section reload ── */
  document.addEventListener('shopify:section:load', function (e) {
    if (e.target && e.target.querySelector('#rareLuggageShowcase-{{ section.id }}')) {
      lcState = {};
      initLuggageShowcase();
    }
  });
  
  })();
</script>


<!-- ========================================
  SCHEMA
  ======================================== -->
{% schema %}
  {
    "name": "Luggage Showcase",
    "tag": "section",
    "class": "section-luggage-showcase",
    "blocks": [
      {
        "type": "product_card",
        "name": "Product Card",
        "settings": [
          {
            "type": "header",
            "content": "Product Info"
          },
          {
            "type": "text",
            "id": "product_title",
            "label": "Title",
            "default": "GALLARDO"
          },
          {
            "type": "textarea",
            "id": "product_description",
            "label": "Description",
            "default": "A Sculpted Hard-Shell Luggage Built for the Modern Indian Traveller."
          },
          {
            "type": "header",
            "content": "Images"
          }, {
            "type": "image_picker",
            "id": "product_image",
            "label": "Main / Thumbnail 1"
          }, {
            "type": "image_picker",
            "id": "thumb_2",
            "label": "Thumbnail 2"
          }, {
            "type": "image_picker",
            "id": "thumb_3",
            "label": "Thumbnail 3"
          }, {
            "type": "image_picker",
            "id": "thumb_4",
            "label": "Thumbnail 4 (optional)"
          }, {
            "type": "header",
            "content": "Options"
          }, {
            "type": "text",
            "id": "finish_text",
            "label": "Color / Finish",
            "default": "Carbon Black"
          }, {
            "type": "text",
            "id": "size_1",
            "label": "Size 1",
            "default": "Cabin"
          }, {
            "type": "text",
            "id": "size_2",
            "label": "Size 2",
            "default": "Medium"
          }, {
            "type": "text",
            "id": "size_3",
            "label": "Size 3",
            "default": "Large"
          }, {
            "type": "text",
            "id": "size_4",
            "label": "Size 4",
            "default": "Cabin+Medium"
          }, {
            "type": "text",
            "id": "size_5",
            "label": "Size 5",
            "default": "Cabin+Medium+Large"
          }, {
            "type": "select",
            "id": "active_size",
            "label": "Default Active Size",
            "default": "size_3",
            "options": [
              {
                "value": "size_1",
                "label": "Size 1"
              },
              {
                "value": "size_2",
                "label": "Size 2"
              },
              {
                "value": "size_3",
                "label": "Size 3"
              },
              {
                "value": "size_4",
                "label": "Size 4"
              }, {
                "value": "size_5",
                "label": "Size 5"
              }
            ]
          }, {
            "type": "url",
            "id": "size_chart_link",
            "label": "Size Chart Link (optional)"
          }, {
            "type": "header",
            "content": "Pricing"
          }, {
            "type": "text",
            "id": "price_text",
            "label": "Price",
            "default": "₹8,999"
          }, {
            "type": "text",
            "id": "price_old",
            "label": "Original Price (struck-through)",
            "default": "₹11,500"
          }, {
            "type": "text",
            "id": "price_note",
            "label": "Price Note",
            "default": "Delivery in 5-7 days | Inclusive of all taxes"
          }, {
            "type": "header",
            "content": "Buttons"
          }, {
            "type": "text",
            "id": "button_label",
            "label": "Primary Button Label",
            "default": "Prebook now"
          }, {
            "type": "url",
            "id": "button_link",
            "label": "Primary Button Link"
          }, {
            "type": "text",
            "id": "button_2_label",
            "label": "Secondary Button Label",
            "default": "Know more"
          }, {
            "type": "url",
            "id": "button_2_link",
            "label": "Secondary Button Link"
          }
        ]
      }
    ],
    "max_blocks": 10,
    "presets": [
      {
        "name": "Luggage Showcase",
        "blocks": [
          {
            "type": "product_card"
          }, {
            "type": "product_card"
          }
        ]
      }
    ]
  }
{% endschema %}